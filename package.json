{
	"name": "dad-project",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": "24.x",
		"pnpm": "11.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"start": "node build/index.js",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:update": "pnpm db:generate && pnpm db:migrate",
		"update-browserslist": "update-browserslist-db"
	},
	"devDependencies": {
		"@better-auth/drizzle-adapter": "1.7.3",
		"@csstools/postcss-oklab-function": "^5.0.11",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.5.0",
		"@types/pg": "^8.23.1",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@vitest/browser-playwright": "^5.0.0",
		"auth": "1.7.3",
		"autoprefixer": "^10.5.5",
		"better-auth": "1.7.3",
		"caniuse-lite": "^1.0.30001810",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"drizzle-orm": "1.0.0-rc.5-169397b",
		"eslint": "^10.10.0",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.0.2",
		"playwright": "^1.63.0",
		"postcss": "^8.5.28",
		"postcss-calc": "^11.1.1",
		"postcss-import": "^17.0.0",
		"postcss-mixins": "^12.1.2",
		"postcss-preset-env": "^11.5.2",
		"postgres": "^3.4.9",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-order": "^8.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.0",
		"update-browserslist-db": "^1.3.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"pg": "^8.23.0"
	}
}