{
	"name": "dad-project",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": "24.x",
		"pnpm": "11.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"start": "node build/index.js",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@better-auth/drizzle-adapter": "1.7.0-rc.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26.1.0",
		"@types/pg": "^8.20.0",
		"@typescript-eslint/eslint-plugin": "^8.63.0",
		"@typescript-eslint/parser": "^8.63.0",
		"@vitest/browser-playwright": "^4.1.10",
		"auth": "1.7.0-rc.1",
		"autoprefixer": "^10.5.2",
		"better-auth": "1.7.0-rc.1",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"eslint": "^10.6.0",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"playwright": "^1.61.1",
		"postcss": "^8.5.16",
		"postcss-calc": "^10.1.1",
		"postcss-preset-env": "^11.3.2",
		"postgres": "^3.4.9",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.3",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.0"
	},
	"dependencies": {
		"pg": "^8.22.0"
	}
}